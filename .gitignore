# Rust 构建产物
/target

# Tauri 生成的 schema（可再生；若做移动端，gen/android、gen/apple 需入库）
/gen/schemas

# 本地草稿（设计稿按其自身约定为 local-only，不入库）
tng-gui-design.md

# 本地工具配置
/.claude
/.agents

# 前端依赖（npm）—— 不入库，各机器自行 npm install
node_modules/

# 前端构建产物（vite build 产出，可再生）
frontend/dist/

# unplugin 残留（已改全局注册，无需按需自动声明；若日后启用再处理）
frontend/components.d.ts

# TS 增量构建信息
*.tsbuildinfo

# npm 本地 registry 配置（环境级，不入库，防止内部镜像 URL 泄漏进 lock）
frontend/.npmrc

# 随包 tng 二进制：
# - 普通版（tng-nora/tng-nora.exe，远程证明关闭时使用）不入库——CI release 时按 TNG_VERSION
#   下载 TNG 官方产物填入（缺失时运行时回退 PATH 上的 tng，开发态兜底）。
# - 远程证明版（4 平台）直接入库并随包分发；RA 启用时按平台映射解析，绝不回退普通版。
/resources/*
!/resources/tng.exe
!/resources/tng-linux-x86_64
!/resources/tng-linux-aarch64
!/resources/tng-aarch64-apple-darwin
