{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tngui",
  "identifier": "com.tngui.app",
  "build": {
    "frontendDist": "./frontend/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": {
      "script": "npm run dev",
      "cwd": "frontend"
    },
    "beforeBuildCommand": {
      "script": "npm run build",
      "cwd": "frontend"
    }
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "TNG GUI",
        "width": 1440,
        "height": 960,
        "resizable": true,
        "minWidth": 1120,
        "minHeight": 720
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "resources": [
      "resources/tng*"
    ]
  }
}
